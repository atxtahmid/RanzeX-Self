<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RanzeX Dashboard</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="icon" href="/favicon.ico">
    <style>
        .dashboard-container {
            position: relative;
        }

        .logout-btn {
            position: absolute;
            top: 25px;
            right: 25px;
            color: #e74c3c;
            text-decoration: none;
            font-weight: bold;
            background: rgba(231, 76, 60, 0.1);
            padding: 8px 15px;
            border-radius: 20px;
            border: 1px solid rgba(231, 76, 60, 0.3);
            transition: 0.3s;
            display: flex;
            align-items: center;
            gap: 5px;
            z-index: 10;
            font-size: 0.9rem;
        }

        .logout-btn:hover {
            background: #e74c3c;
            color: #fff;
        }

        @media (max-width: 768px) {
            .logout-btn {
                top: 15px;
                right: 15px;
                padding: 6px 12px;
                font-size: 0.8rem;
            }

            .logout-text {
                display: none;
            }
        }

        .add-token-btn {
            margin-top: 10px;
            width: 100%;
            padding: 10px;
            background: rgba(138, 43, 226, 0.1);
            border: 1px dashed rgba(138, 43, 226, 0.5);
            color: #a29bfe;
            border-radius: 8px;
            cursor: pointer;
            font-size: 0.9rem;
            font-weight: 600;
            transition: 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            font-family: inherit;
        }

        .add-token-btn:hover {
            background: rgba(138, 43, 226, 0.2);
            border-color: #8a2be2;
            color: #fff;
        }

        .token-modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.8);
            z-index: 9999;
            align-items: center;
            justify-content: center;
            backdrop-filter: blur(5px);
            padding: 20px;
        }

        .token-modal.open {
            display: flex;
        }

        .token-modal-content {
            background: #111116;
            border: 1px solid #8a2be2;
            border-radius: 20px;
            padding: 30px;
            width: 100%;
            max-width: 500px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.7);
            animation: slideUp 0.3s ease;
        }

        @keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .token-modal-content h2 {
            margin: 0 0 8px;
            font-size: 1.5rem;
            color: #fff;
        }

        .token-modal-content p {
            margin: 0 0 20px;
            color: #888;
            font-size: 0.9rem;
            line-height: 1.5;
        }

        .token-input {
            width: 100%;
            padding: 14px;
            background: #050508;
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: #fff;
            border-radius: 12px;
            font-family: monospace;
            font-size: 0.85rem;
            outline: none;
            transition: 0.3s;
            resize: vertical;
            min-height: 100px;
            box-sizing: border-box;
        }

        .token-input:focus {
            border-color: #8a2be2;
            box-shadow: 0 0 15px rgba(138, 43, 226, 0.2);
        }

        .token-preview {
            margin-top: 15px;
            padding: 15px;
            background: #15151a;
            border-radius: 12px;
            border: 1px solid #2ecc71;
            display: none;
            align-items: center;
            gap: 15px;
            animation: slideUp 0.3s ease;
        }

        .token-preview img {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            border: 2px solid #2ecc71;
        }

        .token-preview-info {
            flex: 1;
            min-width: 0;
        }

        .token-preview-name {
            font-weight: 700;
            color: #fff;
            font-size: 1.05rem;
            margin-bottom: 3px;
        }

        .token-preview-id {
            color: #888;
            font-family: monospace;
            font-size: 0.8rem;
        }

        .token-msg {
            margin-top: 15px;
            padding: 12px;
            border-radius: 10px;
            font-size: 0.9rem;
            display: none;
        }

        .token-msg.success {
            background: rgba(46, 204, 113, 0.1);
            border: 1px solid #2ecc71;
            color: #2ecc71;
            display: block;
        }

        .token-msg.error {
            background: rgba(231, 76, 60, 0.1);
            border: 1px solid #e74c3c;
            color: #e74c3c;
            display: block;
        }

        .token-modal-btns {
            display: flex;
            gap: 10px;
            margin-top: 20px;
        }

        .token-modal-btn {
            flex: 1;
            padding: 13px;
            border-radius: 12px;
            border: none;
            cursor: pointer;
            font-weight: 700;
            font-family: inherit;
            font-size: 0.95rem;
            transition: 0.2s;
        }

        .btn-primary {
            background: linear-gradient(90deg, #8a2be2, #6c5ce7);
            color: #fff;
            box-shadow: 0 5px 20px rgba(138, 43, 226, 0.3);
        }

        .btn-primary:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 10px 30px rgba(138, 43, 226, 0.5);
        }

        .btn-primary:disabled {
            opacity: 0.4;
            cursor: not-allowed;
            transform: none;
            box-shadow: none;
        }

        .btn-secondary {
            background: rgba(255, 255, 255, 0.05);
            color: #ccc;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .btn-secondary:hover {
            background: rgba(255, 255, 255, 0.1);
            color: #fff;
        }

        .info-note {
            margin-top: 15px;
            padding: 12px;
            background: rgba(46, 204, 113, 0.05);
            border: 1px solid rgba(46, 204, 113, 0.2);
            border-radius: 10px;
            font-size: 0.8rem;
            color: #2ecc71;
            line-height: 1.5;
        }

        .custom-dropdown-container {
            margin-top: 20px;
            text-align: left;
            width: 100%;
            max-width: 280px;
            margin-left: auto;
            margin-right: auto;
        }

        .custom-dropdown-label {
            color: #b9bbbe;
            font-size: 0.85rem;
            margin-bottom: 8px;
            text-transform: uppercase;
            font-weight: bold;
            letter-spacing: 0.5px;
        }

        .custom-dropdown {
            position: relative;
            user-select: none;
        }

        .dropdown-selected {
            background: rgba(32, 34, 37, 0.8);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 8px;
            padding: 10px 15px;
            display: flex;
            align-items: center;
            cursor: pointer;
            transition: all 0.3s ease;
            backdrop-filter: blur(10px);
        }

        .dropdown-selected:hover {
            background: rgba(47, 49, 54, 0.9);
            border-color: rgba(255, 255, 255, 0.2);
        }

        .dropdown-selected img {
            width: 24px;
            height: 24px;
            border-radius: 50%;
            margin-right: 10px;
            object-fit: cover;
        }

        .dropdown-selected span {
            color: #fff;
            font-weight: 500;
            flex-grow: 1;
        }

        .dropdown-selected i {
            color: #b9bbbe;
            font-size: 0.8rem;
            transition: transform 0.3s ease;
        }

        .custom-dropdown.open .dropdown-selected i {
            transform: rotate(180deg);
        }

        .dropdown-options {
            position: absolute;
            top: 100%;
            left: 0;
            right: 0;
            margin-top: 8px;
            background: #2f3136;
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 8px;
            overflow: hidden;
            opacity: 0;
            visibility: hidden;
            transform: translateY(-10px);
            transition: all 0.3s ease;
            z-index: 100;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
            max-height: 300px;
            overflow-y: auto;
        }

        .custom-dropdown.open .dropdown-options {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }

        .dropdown-option {
            padding: 10px 12px;
            display: flex;
            align-items: center;
            cursor: pointer;
            transition: background 0.2s ease;
            gap: 8px;
        }

        .dropdown-option:hover {
            background: rgba(255, 255, 255, 0.05);
        }

        .dropdown-option.active {
            background: rgba(162, 155, 254, 0.2);
            border-left: 3px solid var(--primary-color);
        }

        .dropdown-option.active span {
            color: var(--primary-color);
        }

        .dropdown-option img {
            width: 24px;
            height: 24px;
            border-radius: 50%;
            object-fit: cover;
            flex-shrink: 0;
        }

        .dropdown-option > span {
            color: #dcddde;
            font-weight: 500;
            flex: 1;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .option-remove-btn {
            background: rgba(231, 76, 60, 0.15);
            border: 1px solid rgba(231, 76, 60, 0.3);
            color: #e74c3c;
            width: 26px;
            height: 26px;
            border-radius: 50%;
            cursor: pointer;
            font-size: 0.7rem;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: 0.2s;
            flex-shrink: 0;
        }

        .option-remove-btn:hover {
            background: #e74c3c;
            color: #fff;
            transform: scale(1.1);
        }
    </style>
</head>

<body>

    <div class="dashboard-container home-container">
        <a href="/logout" class="logout-btn">
            <i class="fas fa-sign-out-alt"></i> <span class="logout-text">Logout</span>
        </a>

        <div class="left-section">
            <div class="profile-section">
                <% let strokeClass='stroke-offline' ; if(status==='online' ) strokeClass='stroke-online' ;
                    if(status==='idle' ) strokeClass='stroke-idle' ; if(status==='dnd' ) strokeClass='stroke-dnd' ; %>

                    <div class="avatar-wrapper <%= strokeClass %>">
                        <img src="<%= user.displayAvatarURL({ format: 'png', dynamic: true, size: 512 }) %>"
                            alt="Avatar" class="avatar">
                    </div>
            </div>

            <div style="text-align: center;">
                <h1 class="username">
                    <%= user.username %>
                        <span class="discriminator">#<%= user.discriminator %></span>
                </h1>

                <div class="uptime-section">
                    <div class="title">System Uptime</div>
                    <div class="uptime-badge">
                        Loading...
                    </div>
                </div>
            </div>

            <hr class="divider">

            <form id="statusForm" action="/update-status" method="POST" class="settings-form">
                <div class="form-group">
                    <label>Status Mode</label>
                    <div class="status-options">
                        <label class="radio-label">
                            <input type="radio" name="status" value="online" <%=status==='online' ? 'checked' : '' %>>
                            <span class="radio-btn online">Online</span>
                        </label>
                        <label class="radio-label">
                            <input type="radio" name="status" value="idle" <%=status==='idle' ? 'checked' : '' %>>
                            <span class="radio-btn idle">Idle</span>
                        </label>
                        <label class="radio-label">
                            <input type="radio" name="status" value="dnd" <%=status==='dnd' ? 'checked' : '' %>>
                            <span class="radio-btn dnd">DND</span>
                        </label>
                        <label class="radio-label">
                            <input type="radio" name="status" value="invisible" <%=status==='invisible' ? 'checked' : ''
                                %>>
                            <span class="radio-btn offline">Invisible</span>
                        </label>
                    </div>
                </div>

                <div class="form-group">
                    <label>Custom Message</label>
                    <input type="text" name="custom_status" class="input-field" placeholder="Playing with code..."
                        value="<%= currentActivity %>">
                </div>

                <div class="form-group">
                    <label>Emoji (Nitro Support)</label>
                    <input type="text" name="emoji" class="input-field" placeholder="🍕 or <:name:id>"
                        value="<%= currentEmoji %>">
                    <small class="hint">Paste emoji or use ID format for custom ones</small>
                </div>

                <button type="submit" id="updateStatusBtn" class="save-btn">Update Status</button>
            </form>
        </div>

        <div class="right-section">
            <img src="https://lanyard.cnrad.dev/api/1292595486129389608?bg=000000&borderRadius=20px&idleMessage=Sleeping...&theme=dark&showDisplayName=true"
                class="brand-image" id="brandImage" alt="Brand Status">

            <div class="creator-text">
                made with RanzeX by 6xux
            </div>

            <% if (typeof clients !== 'undefined' && clients.length > 0) { %>
            <div class="custom-dropdown-container">
                <div class="custom-dropdown-label">Switch Account</div>
                <div class="custom-dropdown" id="accountDropdown">
                    <% 
                        let activeClient = clients.find(c => c.tokenKey === (typeof activeClientKey !== 'undefined' ? activeClientKey : 'TOKEN')) || clients[0];
                    %>
                    <div class="dropdown-selected" onclick="toggleDropdown()">
                        <img src="<%= activeClient.user ? activeClient.user.displayAvatarURL({ format: 'png', size: 64 }) : '/super.png' %>" alt="avatar">
                        <span><%= activeClient.user ? activeClient.user.username : activeClient.tokenKey %></span>
                        <i class="fas fa-chevron-down"></i>
                    </div>
                    <div class="dropdown-options" id="dropdownOptions">
                        <% clients.forEach(function(c) { %>
                            <div class="dropdown-option <%= activeClient.tokenKey === c.tokenKey ? 'active' : '' %>">
                                <img src="<%= c.user ? c.user.displayAvatarURL({ format: 'png', size: 64 }) : '/super.png' %>" alt="avatar" onclick="switchClient('<%= c.tokenKey %>')">
                                <span onclick="switchClient('<%= c.tokenKey %>')"><%= c.user ? c.user.username : c.tokenKey %></span>
                                <% if (c.tokenKey !== 'TOKEN') { %>
                                    <button class="option-remove-btn" title="Remove this token"
                                        onclick="event.stopPropagation(); removeToken('<%= c.tokenKey %>')">
                                        <i class="fas fa-times"></i>
                                    </button>
                                <% } %>
                            </div>
                        <% }) %>
                    </div>
                </div>
                <button class="add-token-btn" onclick="openTokenModal()">
                    <i class="fas fa-plus-circle"></i> Add Another Token
                </button>
            </div>
            <% } %>
        </div>

    </div>

    <div class="token-modal" id="tokenModal">
        <div class="token-modal-content">
            <h2><i class="fas fa-key" style="color:#8a2be2;"></i> Add Discord Token</h2>
            <p>Paste a Discord token below. The bot will validate it, log in, and save it to your Railway volume so it persists across restarts.</p>

            <textarea id="tokenInput" class="token-input" placeholder="Paste your Discord token here..."></textarea>

            <div class="token-preview" id="tokenPreview">
                <img id="previewAvatar" src="" alt="avatar">
                <div class="token-preview-info">
                    <div class="token-preview-name" id="previewName">-</div>
                    <div class="token-preview-id" id="previewId">-</div>
                </div>
                <i class="fas fa-check-circle" style="color:#2ecc71; font-size:1.5rem;"></i>
            </div>

            <div class="token-msg" id="tokenMsg"></div>

            <div class="info-note">
                <i class="fas fa-check-circle"></i>
                This token will be <b>saved to your Railway volume</b> and reload automatically after every restart. Remove it any time via the ✕ button next to the account.
            </div>

            <div class="token-modal-btns">
                <button class="token-modal-btn btn-secondary" onclick="closeTokenModal()">Cancel</button>
                <button class="token-modal-btn btn-primary" id="btnAddToken" onclick="submitToken()" disabled>
                    <i class="fas fa-plus"></i> Add Token
                </button>
            </div>
        </div>
    </div>

    <script>
        let uptimeSeconds = <%= uptimeSeconds %>;
        let tokenDebounce = null;
        let validatedToken = null;

        function toggleDropdown() {
            document.getElementById('accountDropdown').classList.toggle('open');
        }

        document.addEventListener('click', function (event) {
            const dropdown = document.getElementById('accountDropdown');
            if (dropdown && !dropdown.contains(event.target)) {
                dropdown.classList.remove('open');
            }
        });

        function switchClient(key) {
            fetch('/api/switch_client', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ key })
            }).then(res => res.json()).then(data => {
                if (data.success) {
                    window.location.reload();
                }
            });
        }

        async function removeToken(key) {
            if (!confirm(`Remove ${key}? This will log the account out immediately and remove it from storage.`)) return;

            try {
                const res = await fetch('/api/tokens/remove', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ key })
                });
                const data = await res.json();

                if (data.success) {
                    window.location.reload();
                } else {
                    alert('Error: ' + (data.error || 'Failed to remove token'));
                }
            } catch (e) {
                alert('Network error: ' + e.message);
            }
        }

        function updateUptime() {
            uptimeSeconds++;
            let diff = uptimeSeconds;

            let days = Math.floor(diff / 86400);
            diff %= 86400;
            let hours = Math.floor(diff / 3600);
            diff %= 3600;
            let minutes = Math.floor(diff / 60);
            let seconds = Math.floor(diff % 60);

            const uptimeStr = `${days}d ${hours}h ${minutes}m ${seconds}s`;
            document.querySelector('.uptime-badge').innerText = uptimeStr;
        }

        setInterval(updateUptime, 1000);
        updateUptime();

        document.getElementById('statusForm').addEventListener('submit', async function (e) {
            e.preventDefault();
            const btn = document.getElementById('updateStatusBtn');
            const originalText = btn.innerText;
            btn.disabled = true;

            const formData = new FormData(this);
            const data = Object.fromEntries(formData.entries());

            try {
                const res = await fetch('/update-status', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    body: JSON.stringify(data)
                });

                if (res.ok) {
                    btn.style.transition = 'background-color 0.3s';
                    btn.style.backgroundColor = '#43b581';
                    btn.innerText = 'Saved!';

                    setTimeout(() => {
                        btn.style.backgroundColor = '';
                        btn.innerText = originalText;
                        btn.disabled = false;
                    }, 2000);
                } else {
                    alert('Failed to save status.');
                    btn.disabled = false;
                }
            } catch (err) {
                console.error(err);
                alert('Error saving status.');
                btn.disabled = false;
            }
        });

        setInterval(() => {
            const img = document.getElementById('brandImage');
            if (img) {
                const currentSrc = img.src.split('&t=')[0];
                img.src = `${currentSrc}&t=${Date.now()}`;
            }
        }, 15000);

        function openTokenModal() {
            document.getElementById('tokenModal').classList.add('open');
            document.getElementById('tokenInput').value = '';
            document.getElementById('tokenPreview').style.display = 'none';
            document.getElementById('tokenMsg').className = 'token-msg';
            document.getElementById('tokenMsg').style.display = 'none';
            document.getElementById('btnAddToken').disabled = true;
            validatedToken = null;
            setTimeout(() => document.getElementById('tokenInput').focus(), 100);
        }

        function closeTokenModal() {
            document.getElementById('tokenModal').classList.remove('open');
        }

        document.getElementById('tokenModal').addEventListener('click', function (e) {
            if (e.target === this) closeTokenModal();
        });

        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') closeTokenModal();
        });

        document.getElementById('tokenInput').addEventListener('input', function () {
            clearTimeout(tokenDebounce);
            const val = this.value.trim();

            document.getElementById('tokenPreview').style.display = 'none';
            document.getElementById('tokenMsg').className = 'token-msg';
            document.getElementById('tokenMsg').style.display = 'none';
            document.getElementById('btnAddToken').disabled = true;
            validatedToken = null;

            if (val.length < 30) return;

            tokenDebounce = setTimeout(() => validateToken(val), 700);
        });

        async function validateToken(token) {
            const msgEl = document.getElementById('tokenMsg');
            msgEl.className = 'token-msg';
            msgEl.style.display = 'block';
            msgEl.textContent = 'Validating token...';
            msgEl.style.background = 'rgba(138, 43, 226, 0.1)';
            msgEl.style.border = '1px solid #8a2be2';
            msgEl.style.color = '#a29bfe';

            try {
                const res = await fetch('/api/tokens/validate', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ token })
                });
                const data = await res.json();

                if (data.success) {
                    validatedToken = token;
                    document.getElementById('previewAvatar').src = data.user.avatar;
                    document.getElementById('previewName').textContent = data.user.global_name || data.user.username;
                    document.getElementById('previewId').textContent = 'ID: ' + data.user.id;
                    document.getElementById('tokenPreview').style.display = 'flex';

                    msgEl.className = 'token-msg success';
                    msgEl.textContent = '✓ Token is valid';
                    document.getElementById('btnAddToken').disabled = false;
                } else {
                    msgEl.className = 'token-msg error';
                    msgEl.textContent = '✗ ' + (data.error || 'Invalid token');
                    document.getElementById('btnAddToken').disabled = true;
                }
            } catch (e) {
                msgEl.className = 'token-msg error';
                msgEl.textContent = '✗ Network error: ' + e.message;
                document.getElementById('btnAddToken').disabled = true;
            }
        }

        async function submitToken() {
            if (!validatedToken) return;

            const btn = document.getElementById('btnAddToken');
            const msgEl = document.getElementById('tokenMsg');

            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Adding...';

            try {
                const res = await fetch('/api/tokens/add', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ token: validatedToken })
                });
                const data = await res.json();

                if (data.success) {
                    msgEl.className = 'token-msg success';
                    msgEl.textContent = '✓ Token added and saved! Switching...';

                    if (data.alreadyExists) {
                        msgEl.textContent = 'ℹ️ Token already loaded. Switching...';
                    }

                    setTimeout(() => {
                        switchClient(data.key);
                    }, 800);
                } else {
                    msgEl.className = 'token-msg error';
                    msgEl.textContent = '✗ ' + (data.error || 'Failed to add token');
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fas fa-plus"></i> Add Token';
                }
            } catch (e) {
                msgEl.className = 'token-msg error';
                msgEl.textContent = '✗ Network error: ' + e.message;
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-plus"></i> Add Token';
            }
        }
    </script>
    <%- include('partials/super_button') %>
</body>

</html>